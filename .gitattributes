# generated by rust-gate sync; do not edit
# How Git should treat each kind of file.
#
# Without this, line endings depend on whoever cloned the repository, binary
# assets get mangled by normalisation, and review pages fill with generated
# noise. Declaring it here makes every checkout identical on every platform.

# ------------------------------------------------------------ Line endings
# LF in the repository and LF in the working tree, on every operating system.
# A workflow, a Bash script and a Cargo manifest are all read by tools that
# treat a stray CR as part of the value.
* text=auto eol=lf

# ---------------------------------------------------------------- Source
# Marked explicitly so a file whose contents happen to look binary to Git's
# heuristic is still normalised and still diffed as text.
*.rs      text diff=rust
*.toml    text
*.yml     text
*.yaml    text
*.json    text
*.md      text diff=markdown
*.txt     text
*.sh      text eol=lf
justfile  text eol=lf

# ------------------------------------------------------------------ Binary
# Never normalised, never diffed as text, never merged line by line.
*.png   binary
*.webp  binary
*.svg   text

# ------------------------------------------------------------- Review view
# Lock files stay diffable on purpose. They are generated, but a dependency
# change is exactly what a supply-chain review must see, so they are not marked
# generated and not collapsed.
Cargo.lock text linguist-language=TOML
mise.lock  text linguist-language=TOML

# Documentation must not skew this repository's language statistics.
docs/** linguist-documentation

# Fixtures exist to be compiled by the gate, not to describe the repository.
examples/** linguist-vendored=false

# ---------------------------------------------------------- Release archives
# `git archive` produces the source tarball. Development-only material has no
# place in it; the workflows and the action definition do, and so do the
# files the gate reads when the action builds it, .editorconfig and
# .gitattributes among them.
.github/ISSUE_TEMPLATE/     export-ignore
.github/PULL_REQUEST_TEMPLATE.md export-ignore
.gitignore                 export-ignore
.pre-commit-config.yaml    export-ignore
